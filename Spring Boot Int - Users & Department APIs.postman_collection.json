{
  "info": {
    "_postman_id": "fa98c3af-91da-41b2-87f0-b9744e70907e",
    "name": "Spring Boot Int - Users & Department APIs",
    "description": "Postman collection for the Users service. Department service endpoints are excluded because that module requires mTLS and is accessed internally by Users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57356457",
    "_collection_link": "https://go.postman.co/collection/57356457-fa98c3af-91da-41b2-87f0-b9744e70907e?source=collection_link"
  },
  "item": [
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"AliceSmith\",\n  \"email\": \"alice.smith@example.com\",\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "Creates a user. userId and audit timestamps are generated by the service/database."
      },
      "response": []
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"AliceSmithUpdated\",\n  \"email\": \"alice.updated@example.com\",\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ],
          "variable": [
            {
              "key": "userId",
              "value": "{{userId}}",
              "description": "UUID of the user to update"
            }
          ]
        },
        "description": "Updates the user identified by UUID."
      },
      "response": []
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users?userName={{userName}}&page=0&size=10&sortBy=createdDate&sortDir=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "userName",
              "value": "{{userName}}",
              "description": "Optional username filter"
            },
            {
              "key": "page",
              "value": "0",
              "description": "Zero-based page number"
            },
            {
              "key": "size",
              "value": "10",
              "description": "Page size"
            },
            {
              "key": "sortBy",
              "value": "createdDate",
              "description": "Property to sort by"
            },
            {
              "key": "sortDir",
              "value": "desc",
              "description": "Sort direction: asc or desc"
            }
          ]
        },
        "description": "Returns users in a Spring Data page. All query parameters are optional and have controller defaults."
      },
      "response": []
    },
    {
      "name": "Get user department by exact username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/username/{{userName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "username",
            "{{userName}}"
          ],
          "variable": [
            {
              "key": "userName",
              "value": "{{userName}}",
              "description": "Exact username to look up"
            }
          ]
        },
        "description": "Looks up a user and its department through the Users service. The Department module is called internally over mTLS."
      },
      "response": []
    },
    {
      "name": "Get Department By Username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8081/department/getByUsername?userName={{userName}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "department",
            "getByUsername"
          ],
          "query": [
            {
              "key": "userName",
              "value": "{{userName}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "userName",
      "value": "AliceSmith"
    }
  ]
}